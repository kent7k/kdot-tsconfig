{
  "name": "@kent7k/tsconfig",
  "version": "1.0.1",
  "description": "Shared TypeScript base configs (Node 22 / TS 5.9+, TS 6.0-ready)",
  "license": "MIT",
  "files": [
    "*.json",
    "src/**/*.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./base.json": "./base.json",
    "./node-base.json": "./node-base.json",
    "./node-esm.json": "./node-esm.json",
    "./scripts.json": "./scripts.json",
    "./web-base.json": "./web-base.json",
    "./react.json": "./react.json",
    "./web.json": "./web.json",
    "./app.json": "./app.json",
    "./figma.json": "./figma.json"
  },
  "peerDependencies": {
    "typescript": ">=5.9"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kent7k/kdot-tsconfig.git"
  }
}
